#---------------------------------------------------------------------------
# Function to calculate statistics within each headline.type group
calculate_type_stats <- function(df, type) {
df %>%
filter(headline.type == type) %>%
summarize(
mean_conf = mean(confidence, na.rm = TRUE),
median_conf = median(confidence, na.rm = TRUE),
sd_conf = sd(confidence, na.rm = TRUE),
mean_mag = mean(magnitude, na.rm = TRUE),
median_mag = median(magnitude, na.rm = TRUE),
sd_mag = sd(magnitude, na.rm = TRUE)
)
}
# List to store results for each type
up_stats <- list()
down_stats <- list()
mid_stats <- list()
# Apply the function to each dataset for each headline type
for (i in 1:length(datasets)) {
if (question != "q1") {
up_stats[[file_names[i]]] <- calculate_type_stats(datasets[[i]], "increase")
down_stats[[file_names[i]]] <- calculate_type_stats(datasets[[i]], "decrease")
mid_stats[[file_names[i]]] <- calculate_type_stats(datasets[[i]], "uncertain")
}
else {
up_stats[[file_names[i]]] <- calculate_type_stats(datasets[[i]], "positive")
down_stats[[file_names[i]]] <- calculate_type_stats(datasets[[i]], "negative")
mid_stats[[file_names[i]]] <- calculate_type_stats(datasets[[i]], "neutral")
}
}
# Combine the results into a single data frame for each type
up_results <- do.call(rbind, lapply(names(up_stats), function(name) {
data.frame(Dataset = name, up_stats[[name]])
}))
down_results <- do.call(rbind, lapply(names(down_stats), function(name) {
data.frame(Dataset = name, down_stats[[name]])
}))
mid_results <- do.call(rbind, lapply(names(mid_stats), function(name) {
data.frame(Dataset = name, mid_stats[[name]])
}))
# Display the results using stargazer
stargazer(up_results, type = "text", summary = FALSE,
title = paste("Summary Statistics for 'Up' Headline Type", model, question),
rownames = FALSE)
stargazer(down_results, type = "text", summary = FALSE,
title = paste("Summary Statistics for 'Down' Headline Type", model, question),
rownames = FALSE)
stargazer(mid_results, type = "text", summary = FALSE,
title = paste("Summary Statistics for 'Uncertain/Neutral' Headline Type", model, question),
rownames = FALSE)
}
}
# Arrange plots in a grid with 2 columns (one per model)
grid.arrange(grobs = plot_list, nrow = 5)
