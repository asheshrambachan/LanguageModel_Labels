confidence = mean(confidence, na.rm = TRUE),
across(-c(headline.type, confidence, magnitude), first),
.groups = 'drop'
)
unique_records <- df %>%
filter(headline %in% common_headlines) %>%
filter(!duplicated(headline) & !duplicated(headline, fromLast = TRUE))
final_df <- bind_rows(deduplicated, unique_records)
return(final_df)
})
# Assign the deduplicated data to respective variables
base_blanks <- final_data_unique[[1]]
base_json <- final_data_unique[[2]]
cot1 <- final_data_unique[[3]]
cot2 <- final_data_unique[[4]]
cot3 <- final_data_unique[[5]]
persona1 <- final_data_unique[[6]]
persona2 <- final_data_unique[[7]]
persona3 <- final_data_unique[[8]]
persona4 <- final_data_unique[[9]]
rm(final_data_unique, filtered_data)
#-------------------------------------------------------------------------------
# Function to calculate statistics for each dataset
calculate_stats <- function(df) {
# Calculate mean, median, and standard deviation of confidence and magnitude
stats <- df %>%
summarize(
mean_conf = mean(confidence, na.rm = TRUE),
median_conf = median(confidence, na.rm = TRUE),
sd_conf = sd(confidence, na.rm = TRUE),
mean_mag = mean(magnitude, na.rm = TRUE),
median_mag = median(magnitude, na.rm = TRUE),
sd_mag = sd(magnitude, na.rm = TRUE)
)
if (question == "q1") {
counts <- df %>%
summarize(
up = sum(headline.type == "positive", na.rm = TRUE),
down = sum(headline.type == "negative", na.rm = TRUE),
neutral = sum(headline.type == "neutral", na.rm = TRUE)
)
} else {
counts <- df %>%
summarize(
up = sum(headline.type == "increase", na.rm = TRUE),
down = sum(headline.type == "decrease", na.rm = TRUE),
neutral = sum(headline.type == "uncertain", na.rm = TRUE)
)
}
# Combine statistics and frequencies into a single data frame
result <- cbind(stats, counts)
return(result)
}
# List to store results
results_list <- list()
# Apply the function to each dataset and store results
datasets <- list(base_blanks, base_json, cot1, cot2, cot3,
persona1, persona2, persona3, persona4)
for (i in 1:length(datasets)) {
results_list[[file_names[i]]] <- calculate_stats(datasets[[i]])
}
# Combine all results into a single data frame
final_results <- do.call(rbind, lapply(names(results_list), function(name) {
data.frame(Dataset = name, results_list[[name]])
}))
# Display the results using stargazer
stargazer(final_results, type = "text", summary = FALSE,
title = paste("Summary Statistics for Each Dataset", model, question),
rownames = FALSE)
final_results_long <- final_results %>%
pivot_longer(cols = c(up, down, neutral),
names_to = "Type",
values_to = "Frequency")
plot <- ggplot(final_results_long, aes(x = Dataset, y = Frequency, fill = Type)) +
geom_bar(stat = "identity", position = "dodge", color = "white") +  # White outline on the bars
scale_fill_manual(values = c("up" = "green4", "down" = "red3", "neutral" = "orange")) +  # Custom colors
labs(title = paste("Frequency of Headline Label by Prompting Strategy", model, question),
x = "Dataset",
y = "Frequency",
fill = "Headline Type") +
theme_minimal()
plot_list[[paste0(model, "_", q)]] <- plot
}
}
# Arrange plots in a grid with 2 columns (one per model)
grid.arrange(grobs = plot_list, nrow = 5)
questions <- c("q1", "q2", "q3", "q4", "q5")
models <- c("gpt-3.5-turbo", "gpt-4o-mini")
months <- c("jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "octfirst", "octsecond", "nov", "dec")
file_names <- c("base_blanks", "base_json", "cot1", "cot2", "cot3", "persona1", "persona2", "persona3", "persona4")
years <- "19"
return_types <- c("cumulative", "CAPM", "FF3")
read_combine_filter <- function(file_name, months, question, model, return_type) {
combined_df <- months %>%
lapply(function(month) {
file_path <- paste0("./data/step5_returns_merged/", return_type, "/", model, "/", question, "/", question, "_", month, years, "/", file_name, ".csv")
read.csv(file_path)
}) %>%
bind_rows()
filtered_df <- if (return_type == "cumulative") {
combined_df %>%
filter(!is.na(ret_fd1), !is.na(ret_fd5), !is.na(ret_fd10),
!is.na(ret_ld1), !is.na(ret_ld2), !is.na(ret_ld3),
!is.na(headline.type), !is.na(confidence), !is.na(magnitude)) %>%
select(1:15)
} else {
combined_df %>%
filter(!is.na(sum_ret_1), !is.na(sum_ret_5), !is.na(sum_ret_10),
!is.na(headline.type), !is.na(confidence), !is.na(magnitude)) %>%
select(1:15)
}
return(filtered_df)
}
process_question_model <- function(question, model, return_type) {
filtered_data <- lapply(file_names, read_combine_filter, months = months, question = question, model = model, return_type = return_type)
common_headlines <- Reduce(intersect, lapply(filtered_data, `[[`, "headline"))
final_data <- lapply(filtered_data, function(df) {
deduplicated <- df %>%
filter(headline %in% common_headlines) %>%
group_by(headline) %>%
summarize(across(-c(headline.type, confidence, magnitude), first),
headline.type = names(which.max(table(headline.type))),
magnitude = mean(magnitude, na.rm = TRUE),
confidence = mean(confidence, na.rm = TRUE),
.groups = 'drop')
return(deduplicated)
})
output_names <- paste0("./data/step6_common_sample/", return_type, "/", model, "/", question, "/", file_names, ".csv")
mapply(write.csv, final_data, output_names, MoreArgs = list(row.names = FALSE))
}
for (q in questions) {
for (model in models) {
for (return_type in return_types) {
process_question_model(q, model, return_type)
}
}
}
